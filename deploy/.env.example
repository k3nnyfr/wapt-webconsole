# Public URL of the console (OIDC redirect URI: <WWC_PUBLIC_URL>/auth/callback)
WWC_PUBLIC_URL=https://wapt-console.example.org

# WAPT server, by its public URL
WWC_WAPT_URL=https://wapt.example.org
WWC_WAPT_USER=admin

# OpenID Connect provider (Authelia: its public URL)
WWC_OIDC_ISSUER=https://auth.example.org
WWC_OIDC_CLIENT_ID=wapt-webconsole

# Provider groups granting each role (JSON); default: wapt-viewers, wapt-operators, wapt-admins
# WWC_ROLE_GROUPS={"viewer": ["wapt-viewers"], "operator": ["wapt-operators"], "admin": ["wapt-admins"]}

# Loopback port of the frontend, proxied by the nginx of the host
WWC_PORT=8085
